{
  "name": "splitlane",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "description": "A local TUI for operating Claude Code and Codex in separate lanes",
  "bin": {
    "splitlane": "./bin/splitlane.tsx"
  },
  "scripts": {
    "dev": "bun run bin/splitlane.tsx",
    "build": "bun build ./bin/splitlane.tsx --target=bun --outdir=dist",
    "build:compile": "bun build ./bin/splitlane.tsx --compile --outfile=dist/splitlane",
    "typecheck": "tsc --noEmit",
    "probe": "node spike/probe.mjs",
    "probe:live:claude": "node spike/live-claude.mjs --i-understand-this-starts-model-turns",
    "probe:live:codex": "node spike/live-codex.mjs --i-understand-this-starts-model-turns",
    "probe:live:claude-sdk": "node spike/live-claude-sdk.mjs --i-understand-this-starts-model-turns",
    "verify:live:m1": "bun run spike/live-m1-compare.ts --i-understand-this-starts-20-model-turns",
    "test": "node --test test/*.test.mjs && bun test src",
    "test:spike": "node --test test/*.test.mjs",
    "test:production": "bun test src"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "ink": "7.1.1",
    "react": "19.2.0",
    "react-devtools-core": "^6.1.5",
    "string-width": "8.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "bun-types": "1.3.14",
    "typescript": "5.9.3"
  }
}
